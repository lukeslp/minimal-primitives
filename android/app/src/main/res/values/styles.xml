<resources>
    <!-- Before Android 10 there is no system dark mode; pages see a light theme as in a browser. -->
    <style name="Base.Theme.MinimalPrimitives" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.MinimalPrimitives" parent="Base.Theme.MinimalPrimitives">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
