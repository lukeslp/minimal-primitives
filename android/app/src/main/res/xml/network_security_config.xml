<?xml version="1.0" encoding="utf-8"?>
<!-- Defense in depth: the app has no network permission and allows no cleartext. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
