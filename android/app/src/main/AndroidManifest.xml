<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal Primitives runs entirely from bundled assets. There is deliberately
  no INTERNET permission: the WebView cannot reach the network, and outside
  links are handed to the phone's browser. VIBRATE lets the games' existing
  haptic feedback (Hexsweeper's long-press flag, Bending's hits) work as it
  does in a mobile browser. The full flavor adds CAMERA (src/full); the fdroid
  flavor has no camera input and asks for nothing else.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MinimalPrimitives"
        android:usesCleartextTraffic="false"
        tools:targetApi="33">

        <!-- Nothing leaves the device: no WebView usage metrics, and no Safe
             Browsing lookups for pages that are all bundled. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="fontScale|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
